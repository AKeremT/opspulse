# PostgreSQL Database Configuration
POSTGRES_DB=opspulse
POSTGRES_USER=opspulse
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# JWT Security Configuration (use at least a 32-byte random secret in production)
JWT_SECRET=replace_with_at_least_32_byte_random_secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Frontend & CORS Configuration
FRONTEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Public Status Page Caching & Rate Limiting
PUBLIC_STATUS_CACHE_TTL_SECONDS=30
PUBLIC_STATUS_RATE_LIMIT_PER_MINUTE=60

# Email Alerting & SMTP Configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=noreply@opspulse.local
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace_with_smtp_username
SPRING_MAIL_PASSWORD=replace_with_smtp_password
